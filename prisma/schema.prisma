// Mini Jobs & Earn — Prisma schema
// SQLite datasource (see .env DATABASE_URL)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// When using the driver adapter, Prisma does NOT use this URL at runtime —
// the adapter handles the connection. We hardcode a placeholder file: URL
// so Prisma CLI validation passes during `prisma generate` on Vercel.
datasource db {
  provider = "sqlite"
  url      = "file:./db/placeholder.db"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  balance      Float    @default(0)
  totalEarned  Float    @default(0)
  isAdmin      Boolean  @default(false)
  enabled      Boolean  @default(true)
  streak       Int      @default(0)
  bestStreak   Int      @default(0)
  lastJobAt    DateTime?
  referrerId   String?  // who referred this user (username stored for simplicity)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  Submission[]
  transactions Transaction[]
  sessions     Session[]
  withdrawals  Withdrawal[]
  notifications Notification[]
  favorites    Favorite[]
}

model Job {
  id           String   @id @default(cuid())
  title        String
  description  String
  instructions String
  reward       Float    @default(0)
  link         String
  category     String   @default("general")
  featured     Boolean  @default(false)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  Submission[]
  favorites    Favorite[]
}

model Submission {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  status    String   @default("completed") // completed | rejected
  reward    Float
  proof     String?
  createdAt DateTime @default(now())

  job       Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Float
  type         String   // earning | withdrawal | adjustment
  description  String
  submissionId String?
  createdAt    DateTime @default(now())

  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  method    String   @default("bkash") // bkash | nagad | rocket | bank
  account   String   // phone/account number
  status    String   @default("pending") // pending | approved | rejected
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // earning | withdrawal | system | job
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?  // optional view to navigate to
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}
