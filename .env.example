# ─── Local Development (SQLite file) ───
DATABASE_URL="file:./db/custom.db"
DIRECT_DATABASE_URL="file:./db/custom.db"

# ─── Turso (production) — get these from https://turso.tech ───
# After creating a Turso database, run:
#   turso db show <your-db-name> --url      → copy the libsql:// URL
#   turso db tokens create <your-db-name>   → copy the token
#
# On Vercel, set these as Environment Variables:
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DIRECT_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your-long-auth-token-here"
